# Public URL of this app through the Cloudflare Tunnel (Instagram downloads videos from /media/...)
PUBLIC_BASE_URL=https://reels.example.com
# Long random string, n8n sends it as X-API-Key header. Generate: openssl rand -hex 32
API_KEY=
# Optional extra login for the web UI (recommended: Cloudflare Access on the hostname instead/in addition)
UI_USER=
UI_PASSWORD=
# Reddit app (type "script"), https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=linux:reels-manager:v1.0 (by /u/YOUR_REDDIT_NAME)
# libx264 (CPU) or vaapi (Intel GPU, needs /dev/dri in compose). Falls back to libx264 automatically.
ENCODER=libx264
